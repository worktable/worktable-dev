---
/**
 * Flat link list for one sidebar group. Nested groups render as an
 * indented sub-section (none exist in the current config, but the
 * renderer shouldn't silently drop them if one is added).
 */
import { Badge } from "@astrojs/starlight/components"
import type { StarlightRouteData } from "@astrojs/starlight/route-data"

type SidebarEntry = StarlightRouteData["sidebar"][number]

interface Props {
  entries: SidebarEntry[]
}

const { entries } = Astro.props
---

<ul class="wt-side-list">
  {
    entries.map((entry) =>
      entry.type === "link" ? (
        <li>
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? "page" : undefined}
            class:list={[entry.attrs.class]}
            {...entry.attrs}
          >
            <span>{entry.label}</span>
            {entry.badge && (
              <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />
            )}
          </a>
        </li>
      ) : (
        <li class="wt-side-nested">
          <span class="wt-side-nested-label">{entry.label}</span>
          <Astro.self entries={entry.entries} />
        </li>
      ),
    )
  }
</ul>

<style>
  /* Indent guide: a hairline runs down the left of each group's items;
     the active item gets a cobalt segment on that line. */
  .wt-side-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.625rem;
    border-inline-start: 1px solid var(--border);
  }

  .wt-side-list li {
    overflow-wrap: anywhere;
  }

  .wt-side-list a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .wt-side-list a[aria-current="page"]::before {
    content: "";
    position: absolute;
    /* Sit on the group's indent line (list padding + 1px border) */
    inset-inline-start: calc(-0.625rem - 1px);
    inset-block: 0.4375rem;
    width: 2px;
    border-radius: 1px;
    background: var(--primary);
  }

  .wt-side-nested {
    margin-block: 0.25rem;
  }

  .wt-side-nested-label {
    display: block;
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sidebar-foreground);
  }

  .wt-side-nested :global(.wt-side-list) {
    margin-inline-start: 0.625rem;
  }
</style>
