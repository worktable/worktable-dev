{
  "name": "@worktable/openclaw",
  "version": "0.0.9",
  "description": "OpenClaw channel plugin for durable Worktable threads",
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.worktable.dev/",
  "bugs": {
    "url": "https://github.com/worktable/worktable-dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worktable/worktable-dev.git",
    "directory": "plugins/openclaw"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./setup-entry": "./dist/setup-entry.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "worktable",
      "label": "Worktable",
      "blurb": "Connect OpenClaw to durable Worktable threads."
    },
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "install": {
      "clawhubSpec": "clawhub:@worktable/openclaw",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.7.1-2"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "pack:dogfood": "bun run scripts/pack-dogfood.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@types/bun": "1.3.10",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eventsource-parser": "3.0.6",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "3.1.0",
    "json-schema-traverse": "1.0.0",
    "openclaw": "2026.7.1-2",
    "pkce-challenge": "5.0.1",
    "typescript": "5.9.3",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.1"
  }
}
