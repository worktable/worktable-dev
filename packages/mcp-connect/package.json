    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@worktable/types": "workspace:*",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@worktable/config-typescript": "workspace:*",
    "fast-check": "4.6.0",
    "typescript": "5.9.3",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.4"
  }
}
