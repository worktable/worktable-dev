{
  "name": "@worktable/openclaw",
  "version": "0.0.20",
  "description": "Connect OpenClaw to a persistent workspace shared with your agents—local, self-hosted, or in the cloud.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.worktable.dev/",
  "bugs": {
    "url": "https://github.com/worktable/worktable-dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worktable/worktable-dev.git",
    "directory": "packages/openclaw-plugin"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./setup-entry": "./dist/setup-entry.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "worktable",
      "label": "Worktable",
      "blurb": "Connect OpenClaw to a persistent workspace shared with your agents—local, self-hosted, or in the cloud."
    },
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "install": {
      "clawhubSpec": "clawhub:@worktable/openclaw",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.7.1-2"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "pack:dogfood": "bun run scripts/pack-dogfood.ts",
    "verify:discovery": "bun run scripts/verify-packed-discovery.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "openclaw": "2026.7.1-2",
    "typescript": "5.9.3"
  }
}
