{
  "name": "@worktable/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc -b --pretty false",
    "test:browser": "bun run ../../scripts/testing/run.ts full --suite web-browser",
    "test:browser:doc-links": "bun run test:browser",
    "preview": "vite preview",
    "dev:host": "vite --host 0.0.0.0 --port ${WORKTABLE_WEB_PORT:-5180}",
    "preview:host": "vite preview --host 0.0.0.0 --port ${WORKTABLE_WEB_PORT:-5180}"
  },
  "dependencies": {
    "@blocknote/code-block": "0.54.2",
    "@blocknote/core": "0.54.2",
    "@blocknote/react": "0.54.2",
    "@blocknote/shadcn": "0.54.2",
    "@quickdrawjs/core": "0.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/pm": "^3.34.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@worktable/hosted-contract": "workspace:*",
    "@worktable/types": "workspace:*",
    "@worktable/ui": "workspace:*",
    "codemirror-lang-mermaid": "^0.5.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "uqr": "0.1.3",
    "web-vitals": "^5.3.0",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "3.1.0",
    "yjs": "^13.6.33",
    "@worktable/public-analytics": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "pdfjs-dist": "6.5.438",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8"
  }
}
