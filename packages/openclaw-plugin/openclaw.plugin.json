{
  "id": "worktable",
  "name": "Worktable",
  "description": "Connect OpenClaw to a persistent workspace shared with your agents—local, self-hosted, or in the cloud.",
  "version": "0.0.21",
  "icon": "https://www.worktable.dev/favicon.svg",
  "skills": ["./skills"],
  "channels": ["worktable"],
  "activation": {
    "onStartup": true,
    "onCommands": ["worktable"],
    "onChannels": ["worktable"]
  },
  "commandAliases": [
    {
      "name": "worktable",
      "kind": "cli"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "worktable": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "server": {
            "type": "string",
            "format": "uri"
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "authMode": {
            "type": "string",
            "enum": ["local-token", "agent-registration"]
          },
          "agentAuth": {
            "type": "object"
          },
          "pendingAgentAuth": {
            "type": "object"
          },
          "participantName": {
            "type": "string",
            "minLength": 1
          },
          "defaultSpaceId": {
            "type": "string",
            "minLength": 1
          },
          "pendingPairingCode": {
            "type": "string",
            "minLength": 1
          },
          "ownerMemberId": {
            "type": "string",
            "minLength": 1
          },
          "trustOwnAgents": {
            "type": "boolean"
          },
          "trustAllMembers": {
            "type": "boolean"
          },
          "trustAllAgents": {
            "type": "boolean"
          }
        },
        "required": ["server"],
        "anyOf": [
          { "required": ["token"] },
          { "required": ["agentAuth"] },
          { "required": ["pendingAgentAuth"] }
        ]
      },
      "uiHints": {
        "server": {
          "label": "Worktable server"
        },
        "token": {
          "label": "Worktable token",
          "sensitive": true
        },
        "agentAuth": {
          "label": "Retired Agent Registration",
          "help": "No longer used. Connect again with openclaw worktable connect --server <address>.",
          "sensitive": true,
          "advanced": true
        },
        "pendingAgentAuth": {
          "label": "Retired Agent Registration",
          "help": "No longer used. Connect again with openclaw worktable connect --server <address>.",
          "sensitive": true,
          "advanced": true
        },
        "participantName": {
          "label": "Participant name"
        },
        "defaultSpaceId": {
          "label": "Legacy default Space",
          "help": "Compatibility preference for existing connections. New conversations otherwise live in Worktable.",
          "advanced": true
        },
        "pendingPairingCode": {
          "label": "Pending pairing completion",
          "sensitive": true
        },
        "ownerMemberId": {
          "label": "Connected By",
          "help": "The Worktable member who approved this connection. Set by openclaw worktable connect.",
          "advanced": true
        },
        "trustOwnAgents": {
          "label": "Trust Own Agents",
          "help": "Let the other agents you connected to this Worktable direct this agent. On unless set to false."
        },
        "trustAllMembers": {
          "label": "Trust All Members",
          "help": "Let every person in this Worktable direct this agent."
        },
        "trustAllAgents": {
          "label": "Trust All Agents",
          "help": "Let agents that other people connected direct this agent."
        }
      }
    }
  }
}
