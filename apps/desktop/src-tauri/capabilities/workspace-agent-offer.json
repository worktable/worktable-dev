{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace-agent-offer",
  "description": "The offer to move agents on this Mac to the active local loopback workspace, and its answer. Rust checks the page is the active local connection's origin.",
  "local": false,
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "webviews": ["workspace"],
  "permissions": [
    "allow-desktop-workspace-agent-offer",
    "allow-desktop-workspace-answer-agent-offer"
  ]
}
