{
  "name": "@worktable/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc -b --pretty false",
    "test:browser": "bun run ../../scripts/testing/run.ts full --suite web-browser",
    "test:browser:doc-links": "bun run test:browser",
    "preview": "vite preview",
    "dev:host": "vite --host 0.0.0.0 --port ${WORKTABLE_WEB_PORT:-5180}",
    "preview:host": "vite preview --host 0.0.0.0 --port ${WORKTABLE_WEB_PORT:-5180}"
  },
  "dependencies": {
    "@blocknote/code-block": "0.54.2",
    "@blocknote/core": "0.54.2",
    "@blocknote/react": "0.54.2",
    "@blocknote/shadcn": "0.54.2",
    "@quickdrawjs/core": "0.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-router": "^1.167.5",
    "@tanstack/react-start": "^1.166.18",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.8",
    "@worktable/hosted-contract": "workspace:*",
    "@worktable/types": "workspace:*",
    "@worktable/ui": "workspace:*",
    "codemirror-lang-mermaid": "^0.5.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
