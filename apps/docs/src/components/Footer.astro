---
import DefaultFooter from "@astrojs/starlight/components/Footer.astro"
---

<DefaultFooter />

<div class="wt-privacy-controls print:hidden">
  <button
    type="button"
    data-public-analytics-toggle
    aria-pressed="true"
    aria-label="Turn anonymous analytics off for this documentation site"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 3v18h18M8 17v-5m4 5V7m4 10V9m4 8V5" />
    </svg>
    <span data-public-analytics-label>Analytics on</span>
  </button>
  <a href="https://www.worktable.dev/privacy">Privacy</a>
</div>

<script>
  import {
    getPublicAnalyticsChoice,
    setPublicAnalyticsEnabled,
    subscribeToPublicAnalyticsChoice,
  } from "@worktable/public-analytics/browser"

  const button = document.querySelector<HTMLButtonElement>(
    "[data-public-analytics-toggle]",
  )
  const label = button?.querySelector<HTMLElement>(
    "[data-public-analytics-label]",
  )

  const sync = () => {
    if (!button || !label) return
    const choice = getPublicAnalyticsChoice()
    button.disabled = choice.doNotTrack
    button.setAttribute("aria-pressed", String(choice.enabled))
    label.textContent = `Analytics ${choice.enabled ? "on" : "off"}`
    button.setAttribute(
      "aria-label",
      choice.doNotTrack
        ? "Anonymous analytics are off because your browser sends Do Not Track"
        : `Turn anonymous analytics ${choice.enabled ? "off" : "on"} for this documentation site`,
    )
  }

  button?.addEventListener("click", () => {
    const choice = getPublicAnalyticsChoice()
    if (!choice.doNotTrack) setPublicAnalyticsEnabled(!choice.enabled)
  })
  subscribeToPublicAnalyticsChoice(sync)
  sync()
</script>

<style>
  .wt-privacy-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .wt-privacy-controls button,
  .wt-privacy-controls a {
    color: inherit;
    text-decoration: none;
  }

  .wt-privacy-controls button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .wt-privacy-controls button:hover,
  .wt-privacy-controls a:hover {
    color: var(--sl-color-white);
  }

  .wt-privacy-controls button:focus-visible,
  .wt-privacy-controls a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  .wt-privacy-controls button:disabled {
    cursor: not-allowed;
    opacity: 0.65;
  }

  .wt-privacy-controls svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
