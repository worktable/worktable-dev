---
import { PUBLIC_INSTALL_COMMAND } from "@worktable/public-analytics"
import CopyButton from "./CopyButton.astro"
---

<worktable-install-command>
  <pre tabindex="0"><code>{PUBLIC_INSTALL_COMMAND}</code></pre>
  <CopyButton label="Copy install command" text={PUBLIC_INSTALL_COMMAND} install />
</worktable-install-command>

<style>
  worktable-install-command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--border-chrome);
    border-radius: 0.625rem;
    background: var(--well-bg);
  }

  pre {
    margin: 0;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  code { font-family: var(--sl-font-mono); }

  pre:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
