---
import DefaultFooter from "@astrojs/starlight/components/Footer.astro"
---

<DefaultFooter />

<div class="wt-privacy-controls print:hidden">
  <a href="https://www.worktable.cloud/privacy">Privacy</a>
</div>

<style>
  .wt-privacy-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .wt-privacy-controls a {
    color: inherit;
    text-decoration: none;
  }

  .wt-privacy-controls a:hover {
    color: var(--sl-color-white);
  }

  .wt-privacy-controls a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }
</style>
