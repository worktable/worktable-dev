    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "devDependencies": {
    "@worktable/config-typescript": "workspace:*",
    "typescript": "5.9.3",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.4"
  }
}
