{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace-desktop-updates",
  "description": "Desktop update status, checks and restart for the active local loopback workspace only.",
  "local": false,
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "webviews": ["workspace"],
  "permissions": [
    "allow-desktop-workspace-update-status",
    "allow-desktop-workspace-check-for-updates",
    "allow-desktop-workspace-restart-to-update"
  ]
}
