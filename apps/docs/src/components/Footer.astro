---
import DefaultFooter from "@astrojs/starlight/components/Footer.astro"
---

<DefaultFooter />

<div class="wt-privacy-link print:hidden">
  <a href="https://www.worktable.dev/privacy">Privacy</a>
</div>

<style>
  .wt-privacy-link {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .wt-privacy-link a {
    color: inherit;
    text-decoration: none;
  }

  .wt-privacy-link a:hover {
    color: var(--sl-color-white);
  }

  .wt-privacy-link a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }
</style>
