{
  "name": "@worktable/docs",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "bun run --cwd ../.. generate:docs-content",
    "dev": "astro dev --port 7435",
    "prebuild": "bun run --cwd ../.. generate:docs-content",
    "build": "astro check && astro build",
    "precheck": "bun run --cwd ../.. generate:docs-content",
    "check": "astro check",
    "preview": "astro preview",
    "predev:host": "bun run --cwd ../.. generate:docs-content",
    "dev:host": "DEV_ALLOWED_HOSTS=${DEV_ALLOWED_HOSTS:-docs.worktable.dev,worktable.dev,localhost,127.0.0.1} astro dev --host 0.0.0.0 --port ${WORKTABLE_DOCS_PORT:-7483}",
    "preview:host": "DEV_ALLOWED_HOSTS=${DEV_ALLOWED_HOSTS:-docs.worktable.dev,worktable.dev,localhost,127.0.0.1} astro preview --host 0.0.0.0 --port ${WORKTABLE_DOCS_PORT:-7483}"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.2",
    "@worktable/public-analytics": "workspace:*",
    "@worktable/ui": "workspace:*",
    "astro": "^7.0.6",
    "starlight-llms-txt": "^0.11.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "5.9.3"
  }
}
