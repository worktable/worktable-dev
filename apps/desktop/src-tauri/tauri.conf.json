{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worktable",
  "version": "0.1.7",
  "identifier": "dev.worktable.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:15321",
    "beforeDevCommand": "bun run scripts/serve-ui.ts --fontshare",
    "beforeBuildCommand": "bun run scripts/verify-fonts.ts"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "capabilities": [
        "trusted-shell",
        "workspace-window-chrome",
        "workspace-agent-skills"
      ],
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' https://api.fontshare.com; script-src 'self'; font-src 'self' https://cdn.fontshare.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "generated/icon.png"
    ],
    "externalBin": [
      "generated/bin/worktable"
    ],
    "resources": {
      "generated/runtime/worktable/": "worktable-runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://worktable.dev/releases/latest/desktop-updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQUMxMEQ5N0EwRDE0NjYKUldSbUZBMTYyUkNza3A3V3oyeEZvelRJaFBBTGw3T01pTDBNa09mVStsbkdOSVRNQ2l4QkNYMDAK"
    }
  }
}
