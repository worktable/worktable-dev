{
  "name": "worktable",
  "version": "0.1.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/cli",
    "apps/desktop",
    "apps/docs",
    "apps/skill-installer",
    "apps/web",
    "packages/config-typescript",
    "packages/hosted-contract",
    "packages/mcp",
    "packages/mcp-connect",
    "packages/openclaw-plugin",
    "packages/public-analytics",
    "packages/server",
    "packages/types",
    "packages/ui"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "generate:tools": "bun run scripts/generate-mcp-tools.ts",
    "check:tools": "bun run scripts/generate-mcp-tools.ts --check",
    "generate:theme": "bun run scripts/generate-theme.ts",
    "check:theme": "bun run scripts/generate-theme.ts --check",
    "generate:brand": "bun run scripts/generate-brand-assets.ts",
    "check:brand": "bun run scripts/generate-brand-assets.ts --check",
    "release:local": "bun run scripts/build-release.ts",
    "release:lab": "bun run scripts/build-release.ts --profile lab",
    "documents:preflight": "bun run scripts/document-preflight.ts",
    "documents:migration-census": "bun run scripts/document-id-materialization.ts census",
    "documents:materialize-ids": "bun run scripts/document-id-materialization.ts apply",
    "documents:storage-v2-census": "bun run scripts/document-storage-migration-v2.ts census",
    "documents:storage-v2-rehearse": "bun run scripts/document-storage-migration-v2.ts rehearse",
    "release:notes": "bun run scripts/release-notes.ts",
    "release:verify-artifacts": "sh scripts/verify-release-artifacts.sh",
    "release:public-smoke": "sh scripts/public-release-smoke.sh",
    "smoke:local-install": "sh scripts/smoke-local-install.sh",
    "verify:local-e2e": "sh scripts/verify-local-e2e.sh",
    "desktop:prepare": "bun run --cwd apps/desktop prepare:runtime",
    "desktop:prepare:fresh": "bun run --cwd apps/desktop prepare:runtime:fresh",
    "desktop:check": "bun run --cwd apps/desktop check",
    "desktop:ci": "bun run --cwd apps/desktop ci",
    "desktop:dev": "bun run --cwd apps/desktop native:dev",
    "desktop:dev:isolated": "bun run --cwd apps/desktop dev:isolated",
    "desktop:build": "bun run --cwd apps/desktop native:build",
    "generate:docs-content": "bun run scripts/generate-docs-content.ts",
    "build:docs": "bun run generate:docs-content && bun run --cwd apps/docs build",
    "dev:docs": "bun run generate:docs-content && bun run --cwd apps/docs dev:host",
    "serve:docs": "bun run --cwd apps/docs preview:host",
    "fixtures:generate": "bun run packages/server/src/fixtures/cli.ts generate",
    "fixtures:verify": "bun run packages/server/src/fixtures/cli.ts verify",
    "typecheck:lab": "tsc -p scripts/lab/tsconfig.json",
    "test:lab": "bun run scripts/testing/run.ts required --test-path-prefix scripts/lab/",
    "test": "bun run test:required",
    "test:required": "bun run scripts/testing/run.ts required",
    "test:changed": "bun run scripts/testing/run.ts changed",
    "test:full": "bun run scripts/testing/run.ts full",
    "test:stability": "bun run scripts/testing/run.ts stability",
    "test:mutation": "bunx stryker run",
    "test:policy": "bun run scripts/testing/policy.ts",
    "test:health": "bun run scripts/testing/history.ts test-results/canonical",
    "verify:full": "bun run typecheck && bun run typecheck:lab && bun run --cwd packages/openclaw-plugin typecheck && bun run test:policy && bun run test:full && bun run release:lab && bun run --cwd packages/openclaw-plugin pack:dogfood",
    "lab": "bun run scripts/lab/index.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@types/bun": "^1.3.10",
    "fast-check": "^4.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-icons": "5.6.0",
    "sharp": "0.35.3",
    "turbo": "^2.8.8",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@quickdrawjs/core@0.2.0": "patches/@quickdrawjs%2Fcore@0.2.0.patch",
    "@blocknote/core@0.54.2": "patches/@blocknote%2Fcore@0.54.2.patch"
  }
}
