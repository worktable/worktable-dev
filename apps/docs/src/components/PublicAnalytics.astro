---
import { getCollection } from "astro:content"
import {
  type PublicAnalyticsConfig,
} from "@worktable/public-analytics"

const allowedPathnames = (
  await getCollection("docs", ({ data }) => data.draft === false)
)
  .map(({ id }) => (id === "index" ? "/" : `/${id}`))
  .concat("/start/connect-your-agent")
  .sort()
const config = {
  projectToken: import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN,
  apiHost: import.meta.env.PUBLIC_POSTHOG_API_HOST,
  siteSurface: "worktable_docs" as const,
  // Docs never set analytics cookies or store an ID, so they never ask.
  cookieless: true,
  allowedPathnames,
  environmentVariableName: "PUBLIC_POSTHOG_PROJECT_TOKEN",
  isDevelopment: import.meta.env.DEV,
} satisfies PublicAnalyticsConfig
---


<script is:inline define:vars={{ config }}>
  window.__WORKTABLE_PUBLIC_ANALYTICS_CONFIG__ = config
</script>

<script>
  import {
    capturePublicPageview,
    initializePublicAnalytics,
  } from "@worktable/public-analytics/browser"
  import type { PublicAnalyticsConfig } from "@worktable/public-analytics"

  declare global {
    interface Window {
      __WORKTABLE_PUBLIC_ANALYTICS_CONFIG__?: PublicAnalyticsConfig
    }
  }

  // Pages without the client router never fire astro:page-load. A repeated
  // call for the same page is ignored by the collector.
  const capture = () => {
    const config = window.__WORKTABLE_PUBLIC_ANALYTICS_CONFIG__
    if (config && initializePublicAnalytics(config)) capturePublicPageview()
  }
  document.addEventListener("astro:page-load", capture)
  capture()
</script>
