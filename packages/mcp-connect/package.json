{
  "name": "@worktable/mcp-connect",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge.ts",
    "./connector": "./src/connector.ts"
  },
  "scripts": {
    "build": "bun run build:connector",
    "build:connector": "bun run scripts/build-connector.ts",
    "build:mcpb": "bun run scripts/build-mcpb.ts",
